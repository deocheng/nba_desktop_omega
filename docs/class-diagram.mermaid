classDiagram
    direction LR

    class HofEntry {
        +str team_abbr
        +str season
        +str player_name
        +str br_slug
    }

    class ExecEntry {
        +str team_abbr
        +int rk
        +str executive
        +str start
        +str end
        +str notes
    }

    class Config {
        +dict BR_TEAM_SLUGS
        +set TEAM_ABBRS
        +str PROJECT_ROOT
        +load_dotenv() dict
        +get_conn() Connection
    }

    class Fetcher {
        +fetch_team_page(abbr, kind, offline_dir) str
        -_fetch_online(abbr, kind) str
        -_fetch_offline(abbr, kind, offline_dir) str
    }

    class Parser {
        +parse_hof_div(html) list~HofEntry~
        +parse_executives_table(html) list~ExecEntry~
        +normalize_season(token) str
    }

    class Loader {
        +upsert_hof(rows) int
        +upsert_executives(rows) int
        +load_from_gold(gold_json, gold_csv) tuple
    }

    class CLI {
        +main() int
    }

    Config <.. Fetcher : get_conn / slugs
    Config <.. Loader : get_conn
    CLI --> Fetcher : fetch
    CLI --> Parser : parse
    CLI --> Loader : upsert / load_from_gold
    Parser ..> HofEntry : produces
    Parser ..> ExecEntry : produces
    Loader ..> HofEntry : consumes
    Loader ..> ExecEntry : consumes
    Loader --> Config : get_conn
