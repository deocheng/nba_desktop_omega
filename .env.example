# NBACore v8 — crawler wiring (.env 模板，Mac 版)
# 用法: 复制为 .env 并修改下面两个路径
#
# NBA_PYTHON: 装了 psycopg2-binary + pandas 的 Python 解释器
#   （推荐用项目 venv: <项目根>/.venv/bin/python；或系统 python3）
NBA_PYTHON=/Users/yourname/projects/nba_desktop_omega/.venv/bin/python
#
# CRAWLER_SCRIPT: 本机 nba_daily_crawler.py 的绝对路径
#   注意: crawler 包(crawler/)必须与 nba_daily_crawler.py 放在【同一目录】，
#   因为脚本里是 `import crawler`。建议直接指向 external_crawler/ 下的副本。
CRAWLER_SCRIPT=/Users/yourname/projects/nba_desktop_omega/external_crawler/nba_daily_crawler.py
#
# --- 数据库连接（务必改为强口令，且不要提交真实值；.env 已被 gitignore）---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nba
DB_USER=postgres
DB_PASSWORD=<your-strong-db-password>
# 若 Mac 上 Postgres 用了别的端口/库名/密码，改这里或对应环境变量即可。
# 注意: backend/core/config.py 与 common/bridge_constants.py 均从 DB_PASSWORD 读取口令，禁止硬编码。
